\nomenclatureentry{S$RMSE$@[{$RMSE$}]\begingroup Root Mean Square Error\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$D$@[{$D$}]\begingroup Relative error tolerance (typically 0.25)\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$W$@[{$W$}]\begingroup Absolute error tolerance (typically 0.05)\nomeqref {0}|nompageref}{1}
