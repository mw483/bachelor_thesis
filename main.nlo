\nomenclatureentry{S$P_i$@[{$P_i$}]\begingroup Predicted value from LBM simulation\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$O_i$@[{$O_i$}]\begingroup Observed value from AIJ experimental data\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$q$@[{$q$}]\begingroup Hit rate (fraction of predictions within tolerance)\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$FAC2$@[{$FAC2$}]\begingroup Factor of two (fraction of data within a factor of two)\nomeqref {0}|nompageref}{1}
