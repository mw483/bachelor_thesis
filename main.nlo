\nomenclatureentry{P$H$@[{$H$}]\begingroup Reference building height [m]\nomeqref {0}|nompageref}{1}
\nomenclatureentry{P$U_H$@[{$U_H$}]\begingroup Mean wind velocity at building height [m/s]\nomeqref {0}|nompageref}{1}
\nomenclatureentry{P$z_0$@[{$z_0$}]\begingroup Aerodynamic roughness length [m]\nomeqref {0}|nompageref}{1}
\nomenclatureentry{P$\nu$@[{$\nu$}]\begingroup Kinematic viscosity of air [m$^2$/s]\nomeqref {0}|nompageref}{1}
\nomenclatureentry{P$Re$@[{$Re$}]\begingroup Reynolds number\nomeqref {0}|nompageref}{1}
\nomenclatureentry{P$k$@[{$k$}]\begingroup Turbulent Kinetic Energy (TKE) [m$^2$/s$^2$]\nomeqref {0}|nompageref}{1}
\nomenclatureentry{P$u, v, w$@[{$u, v, w$}]\begingroup Velocity components in $x, y, z$ directions [m/s]\nomeqref {0}|nompageref}{1}
\nomenclatureentry{P$u_{rms}, v_{rms}, w_{rms}$@[{$u_{rms}, v_{rms}, w_{rms}$}]\begingroup Root-mean-square velocity fluctuations [m/s]\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$P_i$@[{$P_i$}]\begingroup Predicted value from LBM simulation\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$O_i$@[{$O_i$}]\begingroup Observed value from AIJ experimental data\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$q$@[{$q$}]\begingroup Hit rate (fraction of predictions within tolerance)\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$FAC2$@[{$FAC2$}]\begingroup Factor of two (fraction of data within a factor of two)\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$MAE$@[{$MAE$}]\begingroup Mean Absolute Error\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$RMSE$@[{$RMSE$}]\begingroup Root Mean Square Error\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$D$@[{$D$}]\begingroup Relative error tolerance (typically 0.25)\nomeqref {0}|nompageref}{1}
\nomenclatureentry{S$W$@[{$W$}]\begingroup Absolute error tolerance (typically 0.05)\nomeqref {0}|nompageref}{1}
